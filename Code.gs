/** Hearth & Thorn Grimoire — Google Apps Script backend.
 * Create a blank Google Sheet, open Extensions > Apps Script, paste this file.
 * In Project Settings > Script Properties set SYNC_KEY to a long random secret.
 * Deploy > New deployment > Web app > Execute as Me > Anyone.
 * WARNING: shared-key personal-use solution, not Google-account authentication.
 */
const TAB = 'Recipes';
function sheet_(){const ss=SpreadsheetApp.getActiveSpreadsheet();let s=ss.getSheetByName(TAB);if(!s){s=ss.insertSheet(TAB);s.appendRow(['id','title','category','json']);s.setFrozenRows(1)}return s}
function authorized_(key){const expected=PropertiesService.getScriptProperties().getProperty('SYNC_KEY');return !!expected && String(key||'')===expected}
function doGet(e){const p=e.parameter||{};const callback=String(p.callback||'');if(!/^[A-Za-z_$][\w$]{0,100}$/.test(callback))return ContentService.createTextOutput('Invalid callback');let data;try{if(!authorized_(p.key))throw Error('Invalid sync key');const values=sheet_().getDataRange().getValues().slice(1);data={ok:true,recipes:values.filter(row=>row[3]).map(row=>JSON.parse(row[3]))}}catch(err){data={ok:false,error:String(err.message)}}return ContentService.createTextOutput(callback+'('+JSON.stringify(data)+');').setMimeType(ContentService.MimeType.JAVASCRIPT)}
function doPost(e){try{const p=e.parameter||{};if(!authorized_(p.key))throw Error('Invalid sync key');if(p.action!=='write')throw Error('Invalid action');if((p.payload||'').length>500000)throw Error('Payload too large');const recipes=JSON.parse(p.payload||'[]');if(!Array.isArray(recipes)||recipes.length>1000)throw Error('Invalid recipe collection');recipes.forEach(r=>{if(typeof r.id!=='string'||typeof r.title!=='string'||!Array.isArray(r.ingredients)||!Array.isArray(r.steps))throw Error('Invalid recipe')});const lock=LockService.getScriptLock();lock.waitLock(30000);try{const s=sheet_();s.clearContents();s.appendRow(['id','title','category','json']);if(recipes.length)s.getRange(2,1,recipes.length,4).setValues(recipes.map(r=>[r.id,r.title,r.category||'',JSON.stringify(r)]));SpreadsheetApp.flush()}finally{lock.releaseLock()}return ContentService.createTextOutput(JSON.stringify({ok:true,count:recipes.length})).setMimeType(ContentService.MimeType.JSON)}catch(err){return ContentService.createTextOutput(JSON.stringify({ok:false,error:String(err.message)})).setMimeType(ContentService.MimeType.JSON)}}
